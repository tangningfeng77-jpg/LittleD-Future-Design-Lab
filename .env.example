DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
# Optional: PORT=4173
# For hosting: HOST=0.0.0.0 and PUBLIC_ORIGIN=https://your-domain.example
# 好设计知识接入：好设计馆签发的只读令牌（只给本机服务用，不要提交到仓库）
GD_MCP_TOKEN=
# Optional: GD_BASE=https://haoshejiguan.com
# 托管在公网时的用量保护（可选）：同时连接数、每日连接数、单次连接分钟数
# LITTLED_MAX_SESSIONS=8
# LITTLED_DAILY_SESSIONS=3000
# LITTLED_SESSION_MINUTES=30
# 节目（讲解幻灯片）：用于整理项目档案的模型（走百炼兼容接口，与语音同一把密钥）
# GD_DECK_MODEL=deepseek-v4.1-flash-1017
# 与好设计馆同机部署时，开放项目图集与原理图给节目使用
# GD_MEDIA_DIR=/var/www/gooddesign-site/current
# GD_MEDIA_URL=https://haoshejiguan.com/littled/media
